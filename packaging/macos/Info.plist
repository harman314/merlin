<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Merlin</string>
    <key>CFBundleDisplayName</key><string>Merlin</string>
    <!-- Merlin's own identity. Sharing ZapFast's would make macOS treat the
         two bundles as one app for notifications and Launch Services. -->
    <key>CFBundleIdentifier</key><string>rocks.merlin.Merlin</string>
    <key>CFBundleExecutable</key><string>merlin</string>
    <key>CFBundleIconFile</key><string>merlin</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.social-networking</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>Merlin uses the microphone to record voice messages you choose to send.</string>
    <key>NSHumanReadableCopyright</key><string>MIT License. Not affiliated with WhatsApp or Meta.</string>
</dict>
</plist>
