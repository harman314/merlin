# Maintainer: harman314 <harman314@users.noreply.github.com>
pkgname=merlin-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Fast native WhatsApp client built with Rust and egui"
arch=('x86_64' 'aarch64')
url="https://github.com/harman314/merlin"
license=('MIT')
install="${pkgname}.install"
# Nothing beyond libc is linked directly; winit and glutin dlopen these at
# startup, and this is a GUI-only application, so all of them have to be
# there for it to run at all.
depends=('alsa-lib' 'alsa-plugins' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr')
optdepends=('org.freedesktop.secrets: archive encryption key storage'
            'noto-fonts-emoji: colour emoji in messages and reactions'
            'xdg-desktop-portal: the file picker for attachments')
provides=('merlin')
conflicts=('merlin' 'merlin-git')
options=('!debug' '!strip')
_repo="https://github.com/harman314/merlin"
source_x86_64=("${_repo}/releases/download/v${pkgver}/merlin-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${_repo}/releases/download/v${pkgver}/merlin-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@AMD64_SHA256@')
sha256sums_aarch64=('@ARM64_SHA256@')

package() {
  local target
  case "$CARCH" in
    x86_64) target="x86_64-unknown-linux-gnu" ;;
    aarch64) target="aarch64-unknown-linux-gnu" ;;
  esac
  local dir="${srcdir}/merlin-v${pkgver}-${target}"

  install -Dm755 "${dir}/merlin" "${pkgdir}/usr/bin/merlin"
  install -Dm644 "${dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${dir}/packaging/applications/merlin.desktop" \
    "${pkgdir}/usr/share/applications/merlin.desktop"
  install -Dm644 "${dir}/packaging/icons/merlin.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/merlin.svg"
  # Releases predating theme integration remain valid packaging inputs.
  if [[ -f "${dir}/contrib/omarchy/merlin.json.tpl" ]]; then
    install -Dm644 "${dir}/contrib/omarchy/merlin.json.tpl" \
      "${pkgdir}/usr/share/merlin/omarchy/merlin.json.tpl"
    install -Dm755 "${dir}/contrib/omarchy/merlin-theme" \
      "${pkgdir}/usr/share/merlin/omarchy/merlin-theme"
  fi

}
